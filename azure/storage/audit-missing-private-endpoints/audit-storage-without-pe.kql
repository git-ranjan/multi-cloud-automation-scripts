// ==============================================================================
// KQL Query: Find Azure Storage Accounts WITHOUT Private Endpoints
// Target Service: Azure Resource Graph Explorer
// Run in: portal.azure.com -> Resource Graph Explorer
// ==============================================================================

resources
| where type =~ 'microsoft.storage/storageaccounts'
| extend peConnections = properties.privateEndpointConnections
| extend peCount = array_length(peConnections)
| where peCount == 0 or isnull(peCount)
| project
    subscriptionId,
    resourceGroup,
    storageAccountName = name,
    location,
    sku = sku.name,
    publicNetworkAccess = tostring(properties.publicNetworkAccess),
    allowBlobPublicAccess = tobool(properties.allowBlobPublicAccess),
    minTlsVersion = tostring(properties.minimumTlsVersion),
    requireSecureTransfer = tobool(properties.supportsHttpsTrafficOnly)
| sort by resourceGroup asc, storageAccountName asc