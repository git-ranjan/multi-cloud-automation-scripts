// ==============================================================================
// KQL Query: Find Azure Storage Accounts with Private Endpoints
// Target Service: Azure Resource Graph Explorer
// ==============================================================================

resources
| where type =~ 'microsoft.storage/storageaccounts'
| extend peConnections = properties.privateEndpointConnections
| extend peCount = array_length(peConnections)
| where peCount > 0
| project 
    subscriptionId,
    resourceGroup,
    storageAccountName = name,
    location,
    sku = sku.name,
    privateEndpointCount = peCount,
    privateEndpointConnections = peConnections
| sort by privateEndpointCount desc
